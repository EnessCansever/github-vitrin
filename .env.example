# Server only; required only when the GitHub adapter is called.
# Fine-grained token with public repository read access; no real value here.
GITHUB_TOKEN=
# Server-only snapshot storage and distributed request counters.
MONGODB_URI=
MONGODB_DB=
# Server-only HMAC key for request counters and anonymous session signatures; required at runtime (at least 32 random bytes).
SIGNING_SECRET=

# Server-only canonical public origin for OG absolute URLs; HTTPS required outside development.
# Set the real deployment origin before publishing; no path/query/credentials.
# Development defaults to http://localhost:3000 when unset; set this for another local port.
SITE_URL=
